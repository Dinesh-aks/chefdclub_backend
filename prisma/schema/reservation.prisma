/// Laravel table `reservation`
model Reservation {
  id            Int       @id @default(autoincrement())
  userId        Int?      @map("user_id")
  name          String    @db.VarChar(255)
  email         String    @db.VarChar(255)
  mobile        String?   @db.VarChar(255)
  guest         Int?
  request       String?   @db.Text
  restrictions  String?   @db.Text
  adminComments String?   @map("admin_comments") @db.Text
  date          DateTime? @db.Date
  time          DateTime? @db.Time(0)
  status        String    @default("Reviewing") @db.VarChar(25)
  addDate       DateTime  @default(now()) @map("add_date") @db.Timestamp(0)

  @@index([userId], map: "user_id")
  @@map("reservation")
}
